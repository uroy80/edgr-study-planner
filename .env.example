# ── Postgres (pgvector) ──────────────────────────────────────────────
POSTGRES_USER=studyplanner
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=studyplanner

# ── Ollama (local LLM) ───────────────────────────────────────────────
# Default points at the bundled `ollama` container. To use a NATIVE Ollama
# app on your Mac (Metal-accelerated, much faster), instead set:
#   OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434
# Chat/roadmap model (swap for a bigger one if your host can run it):
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Embedding model for retrieval (RAG):
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
STUDY_MATERIALS_DIR=./data/study-materials
