# ── Postgres (pgvector) ──────────────────────────────────────────────
POSTGRES_USER=studyplanner
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=studyplanner

# ── Ollama (NATIVE on host, Metal-accelerated) ───────────────────────
# Install once:  brew install --cask ollama   (then open it)
# The Dockerized api reaches the host's Ollama via host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
# Chat/roadmap model — qwen3:8b is the sweet spot for a 16 GB M2 Pro:
OLLAMA_CHAT_MODEL=qwen3:8b
# Embedding model for retrieval (RAG):
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
STUDY_MATERIALS_DIR=./data/study-materials
